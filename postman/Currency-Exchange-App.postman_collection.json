{
  "info": {
    "_postman_id": "8d24e3b2-c5c2-4d9f-b287-0f6f48b6c8b1",
    "name": "Currency Exchange App - Frankfurter API",
    "description": "Collection inicial para investigação e validação da API Frankfurter v2. Execute as requisições e registre os resultados em docs/API_TESTS.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.frankfurter.dev" },
    { "key": "baseCurrency", "value": "EUR" },
    { "key": "quoteCurrency", "value": "USD" },
    { "key": "startDate", "value": "2026-10-01" },
    { "key": "endDate", "value": "2026-11-03" }
  ],
  "item": [
    {
      "name": "01 - Moedas disponíveis",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/v2/currencies",
        "description": "Investigar a lista de moedas disponíveis e os campos retornados."
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Resposta é um array', function () { pm.expect(pm.response.json()).to.be.an('array'); });",
            "pm.test('Primeiro item contém iso_code e name', function () {",
            "  const data = pm.response.json();",
            "  if (data.length > 0) { pm.expect(data[0]).to.have.property('iso_code'); pm.expect(data[0]).to.have.property('name'); }",
            "});"
          ]
        }
      }]
    },
    {
      "name": "02 - Cotação EUR para USD",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/v2/rate/{{baseCurrency}}/{{quoteCurrency}}",
        "description": "Consultar uma cotação de par específico. A data efetiva pode variar conforme a publicação mais recente."
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Resposta contém base, quote, date e rate', function () {",
            "  const data = pm.response.json();",
            "  pm.expect(data).to.have.property('base');",
            "  pm.expect(data).to.have.property('quote');",
            "  pm.expect(data).to.have.property('date');",
            "  pm.expect(data.rate).to.be.a('number');",
            "});"
          ]
        }
      }]
    },
    {
      "name": "03 - Histórico EUR para USD",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/v2/rates?from={{startDate}}&to={{endDate}}&base={{baseCurrency}}&quotes={{quoteCurrency}}",
        "description": "Consultar série histórica no intervalo definido pelas variáveis startDate e endDate."
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Resposta é um array', function () { pm.expect(pm.response.json()).to.be.an('array'); });",
            "pm.test('Cada registro possui data, base, quote e rate', function () {",
            "  pm.response.json().forEach(function (item) {",
            "    pm.expect(item).to.have.property('date');",
            "    pm.expect(item).to.have.property('base');",
            "    pm.expect(item).to.have.property('quote');",
            "    pm.expect(item.rate).to.be.a('number');",
            "  });",
            "});"
          ]
        }
      }]
    },
    {
      "name": "04 - Moeda inválida (investigar erro)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/v2/rate/eur/ABC",
        "description": "Observar o status HTTP e o corpo JSON de erro. Não assumir previamente o formato sem executar."
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Resposta HTTP indica erro para moeda inválida', function () {",
            "  pm.expect(pm.response.code).to.be.oneOf([400, 404, 422]);",
            "});"
          ]
        }
      }]
    }
  ]
}
